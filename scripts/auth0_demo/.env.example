# Copy to .env in this directory and fill in the development-tenant values.
AUTH0_DEMO_DOMAIN=your-development-tenant.us.auth0.com
AUTH0_DEMO_TENANT_CONFIRM=your-development-tenant.us.auth0.com
AUTH0_DEMO_ENVIRONMENT=development
AUTH0_DEMO_CLIENT_ID=
AUTH0_DEMO_CLIENT_SECRET=
AUTH0_DEMO_PASSWORD=
AUTH0_DEMO_WELCOME_EMAIL_DISABLED=true
